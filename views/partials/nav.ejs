<header class="bg-white shadow-lg">
  <nav class="container mx-auto flex justify-between items-center py-6">
    <div>
      <a class="text-2xl font-extrabold text-pink-600" href="/">Airbnb</a>
    </div>
    <ul class="flex space-x-4">
      <!-- Index
      <li>

        class="<%= currentPage==='index' ? 'bg-blue-100' : 'hover:bg-blue-100' %> text-blue-600 hover:text-blue-800 px-4
          py-2 rounded font-semibold transition">
          Airbnb
          </a>
      </li> -->

      <!-- Home-->
      <li>
        <a href="/airbnbHome-list"
          class="<%= currentPage === 'airbnbHome-list' ? 'bg-purple-100' : 'hover:bg-purple-100' %> text-purple-600 hover:text-purple-800 px-4 py-2 rounded font-semibold transition ">
          Homes
        </a>
      </li>

      <!-- Add Home -->
      <li>
        <a href="/host/add-home"
          class="<%= currentPage === 'add-home' || currentPage === 'home-added' ? 'bg-pink-100' : 'hover:bg-pink-100' %> text-pink-600 hover:text-pink-800 px-4 py-2 rounded font-semibold transition">
          Add Home
        </a>
      </li>

      <!-- My Favourites -->
      <li>
        <a href="/favourite-list"
          class="text-green-600 hover:text-green-800 px-4 py-2 rounded font-semibold transition <%= currentPage === 'favourite-list' ? 'bg-green-100' : 'hover:bg-green-100' %>">
          My Favourites
        </a>
      </li>

      <!-- Bookings -->
      <li>
        <a href="/booking"
          class="text-yellow-600 hover:text-yellow-800 px-4 py-2 rounded font-semibold transition <%= currentPage === 'booking' ? 'bg-yellow-100' : 'hover:bg-yellow-100' %>">
          Bookings
        </a>
      </li>
       <!-- Host Home List -->
      <li>
        <a href="/host/host-airbnbHome-list"
          class="text-orange-600 hover:text-orange-800 px-4 py-2 rounded font-semibold transition <%= currentPage === 'host-airbnbHome-list' ? 'bg-orange-100' : 'hover:bg-orange-100' %>">
          Host Home List
        </a>
      </li>
    </ul>
  </nav>
